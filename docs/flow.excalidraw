    { "type": "text", "id": "seam_t", "x": 54, "y": 466, "width": 302, "height": 150, "text": "Provider seam — lib/llm.ts\n(used by both LLM calls)\n\nOPENAI_API_KEY set?\n  → openai('gpt-5-mini')\n  else google('gemini-3-flash-preview')\n\ntemperature() returns undefined\nfor reasoning models", "originalText": "Provider seam — lib/llm.ts\n(used by both LLM calls)\n\nOPENAI_API_KEY set?\n  → openai('gpt-5-mini')\n  else google('gemini-3-flash-preview')\n\ntemperature() returns undefined\nfor reasoning models", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#4c1d95", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100082, "version": 1, "versionNonce": 100083, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.3 },
