    { "type": "text", "id": "a_schema_t", "x": 816, "y": 466, "width": 472, "height": 182, "text": "Call 1 output — analysisSchema (Zod-validated)\n\nanalysis = {\n  businessProfile { category, priceTier, aov, voice }\n  inputQuality { rating, assumptions[], questions[] }\n  rankedPublishers[] { id, fitScore, reasons[] }\n  excludedPublishers[] { id, reason }\n  selectedPersonas[] { id, whyRelevant, keyMessage }\n}", "originalText": "Call 1 output — analysisSchema (Zod-validated)\n\nanalysis = {\n  businessProfile { category, priceTier, aov, voice }\n  inputQuality { rating, assumptions[], questions[] }\n  rankedPublishers[] { id, fitScore, reasons[] }\n  excludedPublishers[] { id, reason }\n  selectedPersonas[] { id, whyRelevant, keyMessage }\n}", "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 100092, "version": 1, "versionNonce": 100093, "isDeleted": false, "groupIds": [], "boundElements": null, "link": null, "locked": false, "containerId": null, "lineHeight": 1.35 },
